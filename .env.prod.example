# ChessClass — prod-env (S-30). Скопируйте в .env и заполните секреты.
# .env в git не попадает (.gitignore). Полный список — .env.example.

APP_ENV=prod
LOG_LEVEL=INFO

# --- PostgreSQL / Redis (внутри compose-сети)
POSTGRES_USER=chess
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=chessclass
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
# S-47: prod рекомендуется RS256 + смонтированные ключи (не в git)
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_KID=v1
JWT_LEGACY_HS256=true
JWT_TTL=15m
REFRESH_TTL=30d

# --- публикация (TLS/edge-nginx — S-38; сейчас web на WEB_PORT)
API_BIND=127.0.0.1
API_PORT=8020
API_WORKERS=4
WEB_PORT=3200
# --- TLS/edge (S-38): сертификаты в deploy/certs (не в git)
CERTS_DIR=./deploy/certs
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
WEB_BASE_URL=https://chessclass.example

# --- LLM RouterAI (без ключа шлюз работает в echo-режиме)
LLM_BASE_URL=https://routerai.example/v1
LLM_API_KEY=
LLM_MODEL_L1=minimax-m3.1
LLM_MODEL_L2=deepseek-v4.1
LLM_MODEL_L3=beam-1.0-501b
LLM_MODEL_L3_ALT=claude-sonnet-5.5
LLM_MODEL_JUDGE=decider-flash-v1.2
# Embeddings 768: укажите id 768-мерной модели провайдера; пусто -> hash.
LLM_EMBED_MODEL=
LLM_TIMEOUT_S=40
LLM_LOCAL_FALLBACK=false
BUDGET_FREE_TOKENS_DAY=50000
BUDGET_PRO_TOKENS_DAY=500000

# --- voice (S-44; пустой ключ → только текст)
VOICE_API_KEY=
VOICE_BASE_URL=https://api.elevenlabs.io
VOICE_MODEL_ID=eleven_multilingual_v2
VOICE_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_DAILY_CHARS=20000
VOICE_COST_PER_1K_RUB=0
VOICE_CACHE_DIR=/srv/voice_cache
TOURNAMENT_MAX_PLIES=40

# --- retention/observability (S-46)
AUDIT_RETENTION_DAYS=365
LLM_CALLS_RETENTION_DAYS=180
VOICE_RETENTION_DAYS=30
STUDIES_RETENTION_DAYS=90
RETENTION_ARCHIVE_DIR=/srv/archive
OBS_DISK_MIN_FREE_GB=5
OBS_QUEUE_ALERT_DEPTH=50
OBS_LLM_COST_ALERT_RUB=1000
OBS_TLS_CERT_PATH=
METRICS_TOKEN=
# --- LMS LRS (S-49; без endpoint — только CSV)
LRS_ENABLED=false
LRS_ENDPOINT=
LRS_KEY=
LRS_SECRET=
LMS_SYNC_BATCH=50

# --- seeds (заполняются один раз через `run --rm seed`; смените пароли!)
SEED_ADMIN_EMAIL=admin@chessclass.dev
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_TEACHER_PASSWORD=CHANGE_ME_TEACHER_PASSWORD
SEED_AUDITOR_PASSWORD=CHANGE_ME_AUDITOR_PASSWORD
SEED_STUDENT_PASSWORD=CHANGE_ME_STUDENT_PASSWORD

# --- бэкапы (S-38)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
