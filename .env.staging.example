# ChessClass — staging-env (S-58; ADR-014). Скопируйте в .env.staging и заполните секреты.
# S-58 staging: не хранить реальные секреты в git (.env.staging — в .gitignore).
# База шаблона — .env.prod.example; полный список переменных — .env.example.

APP_ENV=staging
LOG_LEVEL=INFO

# --- PostgreSQL / Redis (внутри compose-сети; наружу — staging-порты ADR-014)
POSTGRES_USER=chess
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=chessclass
POSTGRES_PORT=5440
REDIS_PORT=6387
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
# S-90: staging — только RS256/JWKS. Ключи: .\scripts\gen-jwt-keys.ps1
# (deploy/jwt монтируется в /srv/jwt; ключи не в git).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=/srv/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/srv/jwt/public.pem
JWT_KID=v1
JWT_LEGACY_HS256=false
JWT_TTL=15m
REFRESH_TTL=30d
# S-90: доверенные reverse-proxy для X-Forwarded-For (edge в compose-сети).
PROXY_TRUSTED_HOSTS=172.16.0.0/12,127.0.0.1
# S-92: Sentry опционален; пусто — error-tracking выключен. DSN не коммитить.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1
# build-time DSN для frontend (передаётся build-arg VITE_SENTRY_DSN в CI).
VITE_SENTRY_DSN=

# --- публикация staging (TLS/edge-nginx — как в prod; порты ADR-014)
API_BIND=127.0.0.1
API_PORT=8032
API_WORKERS=4
WEB_PORT=3202
# --- TLS/edge: сертификаты в deploy/certs (не в git)
CERTS_DIR=./deploy/certs
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
WEB_BASE_URL=https://localhost:8443
# CORS allowlist staging (список через запятую или JSON-массив)
CORS_ORIGINS=https://localhost:8443,http://localhost:3202

# --- LLM RouterAI (без ключа/URL шлюз работает в echo-режиме)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_L1=qwen/qwen3.7-flash
LLM_MODEL_L2=deepseek/deepseek-v4.1-flash
LLM_MODEL_L3=anthropic/claude-sonnet-5.5
LLM_MODEL_L3_ALT=x-ai/grok-4.7
LLM_MODEL_JUDGE=google/gemini-3.1-flash-lite
# Embeddings 768: укажите id 768-мерной модели провайдера; пусто -> hash.
LLM_EMBED_MODEL=
LLM_TIMEOUT_S=40
# S-96: LM Studio на GPU-станции (reverse SSH tunnel на 172.18.0.1:8035).
LLM_LOCAL_FALLBACK=true
LLM_LOCAL_BASE_URL=http://172.18.0.1:8035/v1
LLM_LOCAL_MODEL=qwen2.5-7b-instruct
# S-78: ключ LM Studio (Require Auth); пусто — без Authorization
LLM_LOCAL_API_KEY=CHANGE_ME_LM_STUDIO_TOKEN
BUDGET_FREE_TOKENS_DAY=50000
BUDGET_PRO_TOKENS_DAY=500000

# --- voice (S-44; пустой ключ → только текст)
VOICE_API_KEY=
VOICE_BASE_URL=https://api.elevenlabs.io
VOICE_MODEL_ID=eleven_multilingual_v2
VOICE_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_DAILY_CHARS=20000
VOICE_COST_PER_1K_RUB=0
VOICE_CACHE_DIR=/srv/voice_cache
TOURNAMENT_MAX_PLIES=40

# --- retention/observability (S-46)
AUDIT_RETENTION_DAYS=365
LLM_CALLS_RETENTION_DAYS=180
VOICE_RETENTION_DAYS=30
STUDIES_RETENTION_DAYS=90
FAILED_JOBS_RETENTION_DAYS=90
RETENTION_ARCHIVE_DIR=/srv/archive
OBS_DISK_MIN_FREE_GB=5
OBS_QUEUE_ALERT_DEPTH=50
OBS_LLM_COST_ALERT_RUB=1000
OBS_FAILED_JOBS_ALERT_THRESHOLD=10
OBS_TLS_CERT_PATH=
METRICS_TOKEN=
# --- tracing (S-73)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chessclass-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# --- parental consent (S-74)
PARENTAL_CONSENT_TTL_DAYS=7
PARENTAL_CONSENT_POLICY_VERSION=1.0
# --- SMTP (S-75)
# S-93: staging SMTP — те же требования, что prod (верификация email).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_S=15
# --- песочница (S-97): network isolation по умолчанию
SANDBOX_NETWORK_ISOLATION=true
SANDBOX_NETWORK_BACKEND=auto
SANDBOX_CPU_LIMIT_S=1
# --- email outbox (S-83)
EMAIL_OUTBOX_BATCH=50
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_BODY_RETENTION_DAYS=30
EMAIL_OUTBOX_RETENTION_DAYS=90
# --- LMS LRS (S-49; без endpoint — только CSV; живые интеграции — S-59)
LRS_ENABLED=false
LRS_ENDPOINT=
LRS_KEY=
LRS_SECRET=
LMS_SYNC_BATCH=50
# --- LMS LRS OAuth2 (S-67; LRS_OAUTH_CLIENT_ID пуст → Basic fallback)
LRS_OAUTH_TOKEN_URL=
LRS_OAUTH_CLIENT_ID=
LRS_OAUTH_CLIENT_SECRET=
LRS_OAUTH_SCOPE=
# --- Telegram (S-50; без токена — выключено; живые — S-59)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_LINK_TTL_S=600
TELEGRAM_BATCH=50
# --- Telegram webhook / long-poll (S-68)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLL_ENABLED=false
# --- spaced repetition (S-52)
REVIEW_DAILY_LIMIT=20

# --- seeds (заполняются один раз через `run --rm seed`; смените пароли!)
SEED_ADMIN_EMAIL=admin@chessclass.dev
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_TEACHER_PASSWORD=CHANGE_ME_TEACHER_PASSWORD
SEED_AUDITOR_PASSWORD=CHANGE_ME_AUDITOR_PASSWORD
SEED_STUDENT_PASSWORD=CHANGE_ME_STUDENT_PASSWORD

# --- бэкапы (S-38)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# S-93: offsite-бэкапы staging (те же ключи, отдельный bucket/prefix).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres-staging
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_STATUS_VOLUME=chessclass_staging_archive
BACKUP_DOCKER_NETWORK=chessclass-staging-net
BACKUP_EXPECTED_ALEMBIC=0036_s98_legal_hold

# --- S-61: CSP режим web-nginx (report-only до аудита → enforce) и
# egress allowlist (host или *.host; базовые URL провайдеров — сами).
CSP_MODE=report-only
ALLOWED_EGRESS_HOSTS=

# --- образы (S-57+: версия образа; менять при релизе)
IMAGE_TAG=0.8.1
# каталог RouterAI сверен 2026-11-03 (цены ₽/1M; см. runbook llm-gateway §1)
LLM_COST_L1_IN=3.158
LLM_COST_L1_OUT=13.6845
LLM_COST_L2_IN=10.4213
LLM_COST_L2_OUT=28.948
LLM_COST_L3_IN=210.5308
LLM_COST_L3_OUT=1052.6542
LLM_COST_L3_ALT_IN=210.5308
LLM_COST_L3_ALT_OUT=631.5925
LLM_COST_JUDGE_IN=26.3164
LLM_COST_JUDGE_OUT=157.8981
