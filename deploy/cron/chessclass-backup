# /etc/cron.d/chessclass-backup (S-38)
# Установка: cp deploy/cron/chessclass-backup /etc/cron.d/ && chmod 0644 /etc/cron.d/chessclass-backup
# Требуется docker-доступ у root; BACKUP_DIR должен быть на отдельном диске/volume.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 3 * * * root cd /opt/chessclass && BACKUP_DIR=/var/backups/chessclass BACKUP_RETENTION_DAYS=14 bash backend/scripts/backup.sh >> /var/log/chessclass-backup.log 2>&1
