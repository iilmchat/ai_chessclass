# S-82: prod-Prometheus — конфиг-ШАБЛОН. Prometheus v3 не умеет подстановку
# env в конфиг (флага --config.expand-env нет), поэтому entrypoint рендерит
# этот файл в /tmp, подставляя METRICS_TOKEN (Bearer для scrape /metrics).
# Правила — deploy/observability/alerts.yml, алерты → Alertmanager (Telegram).
global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s
  external_labels:
    env: prod

rule_files:
  - /etc/prometheus-rules/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]
      timeout: 10s

scrape_configs:
  # METRICS_TOKEN подставляется entrypoint (см. prometheus-entrypoint.sh).
  # Пустой токен = API не требует авторизации (dev-подобный режим).
  - job_name: chessclass-api
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials: "__METRICS_TOKEN__"
    static_configs:
      - targets: ["api:8020"]

  - job_name: otel-collector
    static_configs:
      - targets: ["otel-collector:8889"]

  # S-87: файловые системы volumes observability (node_filesystem_*).
  - job_name: node-exporter
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]
