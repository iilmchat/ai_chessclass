# S-82/S-87: Alertmanager prod — Telegram (основной) + email (второй канал).
# Это ШАБЛОН: Alertmanager 0.28 не умеет env-expansion в конфиге, поэтому
# alertmanager-render.sh рендерит этот файл в /tmp/alertmanager.yml, подставляя
# env TELEGRAM_BOT_TOKEN, TELEGRAM_ALERT_CHAT_ID, ALERT_TELEGRAM_API_URL и
# SMTP_*/ALERT_EMAIL_TO. Рендер-файл живёт только в контейнере (chmod 600),
# токены не логируются и не коммитятся.
#
# Второй receiver (email) включается условно: если SMTP_HOST и ALERT_EMAIL_TO
# не заданы, блоки # __EMAIL_BEGIN__ … # __EMAIL_END__ удаляются при рендере.
global:
  resolve_timeout: 1m
  telegram_api_url: __ALERT_TELEGRAM_API_URL__

templates:
  - /etc/alertmanager/telegram.tmpl

route:
  receiver: telegram
  # Группируем по сути алерта: один incident — одно сообщение, а не шум.
  group_by: [alertname, severity, component]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
  routes:
    # critical — быстрее повторяем; continue: true отправляет тот же алерт
    # вторым receiver'ом (email), не блокируя Telegram.
    - matchers:
        - severity="critical"
      receiver: telegram-critical
      continue: true
      repeat_interval: 1h
    # __EMAIL_BEGIN__
    - matchers:
        - severity="critical"
      receiver: email
      repeat_interval: 1h
    # __EMAIL_END__
    # warning — реже, чтобы не будить дежурного ночью.
    - matchers:
        - severity="warning"
      receiver: telegram
      continue: true
      repeat_interval: 6h
    # __EMAIL_BEGIN__
    - matchers:
        - severity="warning"
      receiver: email
      repeat_interval: 6h
    # __EMAIL_END__

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        chat_id: __TELEGRAM_ALERT_CHAT_ID__
        parse_mode: HTML
        send_resolved: true
        message: '{{ template "telegram.chessclass" . }}'

  - name: telegram-critical
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        chat_id: __TELEGRAM_ALERT_CHAT_ID__
        parse_mode: HTML
        send_resolved: true
        message: '{{ template "telegram.chessclass" . }}'

  # S-87: второй receiver. Отдельный маршрут (а не несколько integrations в
  # одном receiver) — падение/таймаут SMTP не задерживает Telegram.
  # __EMAIL_BEGIN__
  - name: email
    email_configs:
      - to: "__ALERT_EMAIL_TO__"
        from: "__SMTP_FROM__"
        smarthost: "__SMTP_HOST__:__SMTP_PORT__"
        auth_username: "__SMTP_USER__"
        auth_password: "__SMTP_PASSWORD__"
        require_tls: __SMTP_REQUIRE_TLS__
        send_resolved: true
  # __EMAIL_END__

# Подавление дублей: critical уже сообщает о проблеме — warning того же
# alertname/component не нужен. Падение API гасит остальные api-алерты
# (они следствие недоступности, а не отдельные инциденты).
inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [alertname, component]

  - source_matchers:
      - alertname="ChessClassApiDown"
    target_matchers:
      - component="api"
    equal: [component]
