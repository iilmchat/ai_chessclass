# ChessClass — шаблон окружения (копировать в .env).
# Источник контракта переменных: Design.md §15.2. Порты: ADR-013 (5438/6384).

# --- infra (наружные порты хоста; внутри compose-сети — 5432/6379)
POSTGRES_HOST=db
POSTGRES_PORT=5438
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess_dev_2026
POSTGRES_DB=chessclass
DATABASE_URL=postgresql+asyncpg://chess:chess_dev_2026@localhost:5438/chessclass
REDIS_URL=redis://localhost:6384/0
API_PORT=8020
WEB_PORT=3200

# --- приложение
APP_ENV=dev
LOG_LEVEL=INFO
JWT_SECRET=dev-secret-change-me-please-0123456789abcdef
# S-47: HS256 по умолчанию; для RS256 задайте алгоритм и ключи/пути
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_KID=v1
JWT_LEGACY_HS256=true
JWT_TTL=15m
REFRESH_TTL=30d
EMBEDDING_DIM=768

# --- LLM-шлюз (активируются в S-04; слаги — ожидаемые имена, сверяются
# с провайдером на бутстрапе; несоответствие → warning, задать актуальные здесь)
# Cloud (RouterAI): LLM_BASE_URL=<endpoint>/v1, LLM_API_KEY=<ключ>.
# Local LM Studio: LLM_BASE_URL=http://host.docker.internal:8034/v1 (Docker)
# или http://127.0.0.1:8034/v1 (backend на хосте); LLM_API_KEY пустой;
# все LLM_MODEL_* = id из GET /v1/models (например qwen/qwen3-4b-2507);
# LLM_COST_* = 0. В LM Studio включите "Serve on Local Network".
LLM_BASE_URL=
LLM_API_KEY=
# RouterAI: id моделей — полные slug'и из GET /v1/models; Decider — decisions-API,
# поэтому judge-route использует chat-совместимый Gemini Flash Lite (S-31).
LLM_MODEL_L1=qwen/qwen3.7-flash
LLM_MODEL_L2=deepseek/deepseek-v4.1-flash
LLM_MODEL_L3=anthropic/claude-sonnet-5.5
LLM_MODEL_L3_ALT=x-ai/grok-4.7
LLM_MODEL_JUDGE=google/gemini-3.1-flash-lite
# Embeddings 768: пусто -> hash-фолбэк (dev); prod — id 768-мерной модели.
LLM_EMBED_MODEL=
LLM_TIMEOUT_S=40
LLM_RETRY_DELAY_S=2
LLM_LOCAL_FALLBACK=false
LLM_LOCAL_BASE_URL=http://localhost:1234/v1
# S-78: ключ LM Studio (Require Auth); пусто — без Authorization
LLM_LOCAL_API_KEY=
LLM_COST_CURRENCY=RUB
# цены ₽/1M из каталога RouterAI на 2026-11-01 (для локальной модели — 0)
LLM_COST_L1_IN=3.158
LLM_COST_L1_OUT=13.6845
LLM_COST_L2_IN=10.4213
LLM_COST_L2_OUT=28.948
LLM_COST_L3_IN=210.5308
LLM_COST_L3_OUT=1052.6542
LLM_COST_L3_ALT_IN=210.5308
LLM_COST_L3_ALT_OUT=631.5925
LLM_COST_JUDGE_IN=26.3164
LLM_COST_JUDGE_OUT=157.8981
BUDGET_FREE_TOKENS_DAY=50000
BUDGET_PRO_TOKENS_DAY=500000

# --- engine / sandbox (E-03+, E-04+)
STOCKFISH_PATH=/usr/local/bin/stockfish
SF_THREADS=1
SF_HASH_MB=16
SF_INTERACTIVE_MOVETIME_MS=1000
MAX_PLIES=60
BOT_MATCH_BUDGET_S=120
BOT_PERMOVE_TIMEOUT_S=1.0
BOT_MATCH_CONCURRENCY=2
BOT_TRIVIAL_MIN_LINES=5
APP_ROLE=api
# песочница (S-07; Design §13.2)
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_MAX_OUTPUT_CHARS=65536
SANDBOX_TIMEOUT_S=5
# S-43: лимит генераций этюдов на пользователя/сутки
STUDY_DAILY_LIMIT=10
TOURNAMENT_MAX_PLIES=40
# --- voice (S-44; без ключа — graceful fallback на текст)
VOICE_API_KEY=
VOICE_BASE_URL=https://api.elevenlabs.io
VOICE_MODEL_ID=eleven_multilingual_v2
VOICE_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_DAILY_CHARS=20000
VOICE_COST_PER_1K_RUB=0
VOICE_CACHE_DIR=voice_cache
# --- retention/observability (S-46)
AUDIT_RETENTION_DAYS=365
LLM_CALLS_RETENTION_DAYS=180
VOICE_RETENTION_DAYS=30
STUDIES_RETENTION_DAYS=90
FAILED_JOBS_RETENTION_DAYS=90
RETENTION_ARCHIVE_DIR=archive
OBS_DISK_MIN_FREE_GB=5
OBS_QUEUE_ALERT_DEPTH=50
OBS_LLM_COST_ALERT_RUB=1000
OBS_FAILED_JOBS_ALERT_THRESHOLD=10
OBS_TLS_CERT_PATH=
METRICS_TOKEN=
# --- tracing (S-73, ADR-017); пусто → спаны создаются, но не экспортируются
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chessclass-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# --- S-82: prod-observability (docker-compose.prod.yml, профиль observability).
# В dev-стеке не используется; переменная обязательна для prod-compose.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
# --- parental consent (S-74, ADR-019)
PARENTAL_CONSENT_TTL_DAYS=7
PARENTAL_CONSENT_POLICY_VERSION=1.0
# --- SMTP (S-75); пусто → письма в лог (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@chessclass.dev
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_S=15
# --- email outbox (S-83): очередь писем с retry/backoff
EMAIL_OUTBOX_BATCH=50
EMAIL_OUTBOX_MAX_ATTEMPTS=8
# --- LMS LRS (S-49; пусто/disabled → только локальный CSV)
LRS_ENABLED=false
LRS_ENDPOINT=
LRS_KEY=
LRS_SECRET=
LMS_SYNC_BATCH=50
# --- LMS LRS OAuth2 (S-67; LRS_OAUTH_CLIENT_ID пуст → Basic fallback)
LRS_OAUTH_TOKEN_URL=
LRS_OAUTH_CLIENT_ID=
LRS_OAUTH_CLIENT_SECRET=
LRS_OAUTH_SCOPE=
# --- Telegram (S-50; пусто → graceful off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_LINK_TTL_S=600
TELEGRAM_BATCH=50
# --- Telegram webhook / long-poll (S-68)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLL_ENABLED=false
# --- spaced repetition (S-52)
REVIEW_DAILY_LIMIT=20

# --- S-61: egress allowlist (comma/JSON); записи вида host или *.host.
# Базовые URL провайдеров (LLM/VOICE/TELEGRAM/LRS) разрешены сами;
# loopback — всегда. Нарушение → 502 egress_blocked.
ALLOWED_EGRESS_HOSTS=

    # --- интеграции (backlog)
ELEVENLABS_API_KEY=

# --- seeds (S-03; менять в прод-окружении!)
SEED_ADMIN_PASSWORD=dev-admin-2026
SEED_TEACHER_PASSWORD=dev-teacher-2026
SEED_AUDITOR_PASSWORD=dev-auditor-2026
SEED_STUDENT_PASSWORD=dev-student-2026
